cc_library_shared {
    name: "libfmjni-qcom",
    stem: "libfmjni",

    cflags: select(soong_config_variable("libfmjni", "no_fm_firmware"), {
        true: ["-DQCOM_NO_FM_FIRMWARE"],
        default: [],
    }),

    srcs: [
        "FmIoctlsInterface.cpp",
        "ConfigFmThs.cpp",
        "FmPerformanceParams.cpp",
        "ConfFileParser.cpp",
        "FmRadioController.cpp",
        "LibfmJni.cpp",
    ],

    include_dirs: [
        "frameworks/base/core/jni/include",
    ],

    shared_libs: [
        "libcutils",
        "libdl",
        "liblog",
        "libmedia",
        "libnativehelper",
    ],
}
